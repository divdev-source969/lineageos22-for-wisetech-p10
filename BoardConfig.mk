DEVICE_PATH := device/wisephone/p10

# Vendor blobs (generated by extract-files.py)
-include vendor/wisephone/p10/BoardConfigVendor.mk

# ---------------------------------------------------------------
# Architecture (A53, 32-bit userland)
# ---------------------------------------------------------------
TARGET_ARCH := arm
TARGET_ARCH_VARIANT := armv7-a-neon
TARGET_CPU_ABI := armeabi-v7a
TARGET_CPU_ABI2 := armeabi
TARGET_CPU_VARIANT := cortex-a53

# ---------------------------------------------------------------
# Platform
# ---------------------------------------------------------------
TARGET_BOARD_PLATFORM := mt6739
TARGET_BOOTLOADER_BOARD_NAME := mt6739ch
TARGET_NO_BOOTLOADER := true
TARGET_NO_RADIOIMAGE := true
TARGET_OTA_ASSERT_DEVICE := p10,wisephone_p10

# ---------------------------------------------------------------
# Kernel
# ---------------------------------------------------------------
# TODO: check `uname -m` and /proc/config.gz on stock.
# 32-bit kernel => arm. 64-bit kernel + 32-bit userland => arm64 and
# also set TARGET_USES_64_BIT_BINDER := true
TARGET_KERNEL_ARCH := arm
TARGET_KERNEL_HEADER_ARCH := arm
TARGET_KERNEL_SOURCE := kernel/wisephone/mt6739
TARGET_KERNEL_CONFIG := p10_defconfig
BOARD_KERNEL_IMAGE_NAME := zImage
# TARGET_USES_64_BIT_BINDER := true

# Alternative: prebuilt kernel (comment out the source lines above)
# TARGET_FORCE_PREBUILT_KERNEL := true
# TARGET_PREBUILT_KERNEL := $(DEVICE_PATH)/prebuilt/zImage

# TODO: all of these come from `unpackbootimg` on the stock boot.img
BOARD_BOOTIMG_HEADER_VERSION := 0
BOARD_KERNEL_CMDLINE :=
# BOARD_KERNEL_BASE := 0x80000000
# BOARD_KERNEL_PAGESIZE := 2048
# BOARD_MKBOOTIMG_ARGS += --kernel_offset 0x00008000
# BOARD_MKBOOTIMG_ARGS += --ramdisk_offset 0x04000000
# BOARD_MKBOOTIMG_ARGS += --tags_offset 0x0e000000
# MTK boot images also carry a 512-byte header on kernel/ramdisk:
# you may need a custom mkbootimg or MTK header tool.

# ---------------------------------------------------------------
# Partitions (TODO: MUST match the scatter file, values in bytes)
# ---------------------------------------------------------------
BOARD_FLASH_BLOCK_SIZE := 131072
BOARD_BOOTIMAGE_PARTITION_SIZE := 33554432
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 33554432
BOARD_SYSTEMIMAGE_PARTITION_SIZE := 2147483648
BOARD_VENDORIMAGE_PARTITION_SIZE := 536870912
BOARD_USERDATAIMAGE_PARTITION_SIZE := 4294967296

BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := ext4
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := false
TARGET_COPY_OUT_VENDOR := vendor
BOARD_HAS_LARGE_FILESYSTEM := true

# Legacy device: no dynamic partitions, no A/B
BOARD_BUILD_SYSTEM_ROOT_IMAGE := false
AB_OTA_UPDATER := false

# ---------------------------------------------------------------
# Recovery
# ---------------------------------------------------------------
TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/rootdir/etc/fstab.mt6739
TARGET_RECOVERY_PIXEL_FORMAT := RGBX_8888
TARGET_USERIMAGES_SPARSE_EXT_DISABLED := false
BOARD_HAS_NO_SELECT_BUTTON := true

# ---------------------------------------------------------------
# Verified boot / encryption
# ---------------------------------------------------------------
BOARD_AVB_ENABLE := false
# TODO: enable if stock uses FBE
# TARGET_HW_DISK_ENCRYPTION := false

# ---------------------------------------------------------------
# Treble / VINTF
# ---------------------------------------------------------------
BOARD_VNDK_VERSION := current
DEVICE_MANIFEST_FILE := $(DEVICE_PATH)/manifest.xml
# DEVICE_MATRIX_FILE := $(DEVICE_PATH)/compatibility_matrix.xml

# ---------------------------------------------------------------
# SELinux
# ---------------------------------------------------------------
BOARD_VENDOR_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/vendor
# Permissive is for first bring-up ONLY (also set androidboot.selinux=permissive)
# BOARD_KERNEL_CMDLINE += androidboot.selinux=permissive

# ---------------------------------------------------------------
# Wi-Fi (MediaTek WMT / connsys)
# ---------------------------------------------------------------
BOARD_WLAN_DEVICE := MediaTek
BOARD_HOSTAPD_DRIVER := NL80211
BOARD_WPA_SUPPLICANT_DRIVER := NL80211
WPA_SUPPLICANT_VERSION := VER_0_8_X
WIFI_DRIVER_STATE_CTRL_PARAM := /dev/wmtWifi
WIFI_DRIVER_STATE_ON := 1
WIFI_DRIVER_STATE_OFF := 0

# ---------------------------------------------------------------
# Bluetooth
# ---------------------------------------------------------------
BOARD_HAVE_BLUETOOTH := true

# ---------------------------------------------------------------
# Memory
# ---------------------------------------------------------------
MALLOC_SVELTE := true
PRODUCT_MINIMIZE_JAVA_DEBUG_INFO := true

# ---------------------------------------------------------------
# Display
# ---------------------------------------------------------------
TARGET_SCREEN_DENSITY := 280
# 720x1440 is set via overlay/ and density above
