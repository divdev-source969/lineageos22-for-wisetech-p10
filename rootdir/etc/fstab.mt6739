# <src>                                          <mnt_point> <type> <mnt_flags and options>                                     <fs_mgr_flags>
# TODO: verify every by-name entry against the scatter file / `ls /dev/block/platform/bootdevice/by-name`
/dev/block/platform/bootdevice/by-name/system    /system     ext4   ro,barrier=1                                               wait,first_stage_mount
/dev/block/platform/bootdevice/by-name/vendor    /vendor     ext4   ro,barrier=1                                               wait,first_stage_mount
/dev/block/platform/bootdevice/by-name/userdata  /data       ext4   noatime,nosuid,nodev,noauto_da_alloc,discard,errors=panic  wait,check,formattable,quota,latemount
/dev/block/platform/bootdevice/by-name/cache     /cache      ext4   noatime,nosuid,nodev,noauto_da_alloc,discard,errors=panic  wait,check,formattable
/dev/block/platform/bootdevice/by-name/nvdata    /mnt/vendor/nvdata ext4 noatime,nosuid,nodev,noauto_da_alloc                  wait,check
/dev/block/platform/bootdevice/by-name/nvram     /nvram      emmc   defaults                                                   defaults
/dev/block/platform/bootdevice/by-name/boot      /boot       emmc   defaults                                                   defaults
/dev/block/platform/bootdevice/by-name/recovery  /recovery   emmc   defaults                                                   defaults
/dev/block/platform/bootdevice/by-name/misc      /misc       emmc   defaults                                                   defaults
/devices/platform/externdevice*                  auto        auto   defaults                                                   voldmanaged=sdcard1:auto,encryptable=userdata
/devices/platform/mt_usb*                        auto        auto   defaults                                                   voldmanaged=usbotg:auto
